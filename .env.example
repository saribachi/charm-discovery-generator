# NO ANTHROPIC_API_KEY. Deliberately.
# The server cannot generate decks and must not be able to spend API credits.
# Generation happens on a Mac running Claude Code against the Claude
# subscription, which claims jobs from the queue. See local/README.md.

# Required in production. Gates the generator console (not the deck links).
APP_PASSWORD=change-me

# Optional. Signs the session cookie. Defaults to a value derived from APP_PASSWORD.
SESSION_SECRET=

# Optional. Coolify injects this when a Postgres service is linked.
# Without it, decks are stored in ./data/decks.json instead.
DATABASE_URL=

# Set to "require" if the Postgres needs SSL
PGSSL=

PORT=3000

# --- Daily GHL pre-warm (optional) ---------------------------------------
# Leave GHL_TOKEN unset and the scheduler stays off; the app works as normal.
# Private Integration Token from GHL > Settings > Private Integrations.
# Scopes needed: calendars.readonly, calendars/events.readonly, contacts.readonly
GHL_TOKEN=pit-...
# The sub-account id, visible in the GHL URL: /v2/location/<THIS>/dashboard
GHL_LOCATION_ID=

# When the job runs, in PREWARM_TZ. Defaults to 08:00 America/Los_Angeles.
PREWARM_HOUR=8
PREWARM_MINUTE=0
PREWARM_TZ=America/Los_Angeles
# Reuse an existing deck for a domain if it is younger than this many days.
PREWARM_FRESH_DAYS=14
